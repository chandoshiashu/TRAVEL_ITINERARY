<!DOCTYPE html>
<html class="scroll-smooth">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Roamio | Trip Planner</title>
	<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
	<link rel="stylesheet" href="/style.css"> 

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400..800&family=Comic+Relief:wght@400;700&display=swap" rel="stylesheet">
	<script src="https://kit.fontawesome.com/0d0926c306.js" crossorigin="anonymous"></script>

</head>

<style>

@import url('https://fonts.googleapis.com/css2?family=Tapestry&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Ubuntu:ital@1&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@600&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Merriweather:ital@1&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans:wght@500&display=swap');
@import url('https://fonts.googleapis.com/css2?family=PT+Sans&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Macondo&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');


.Tapestry {
    font-family: 'Tapestry', cursive;
}

.Ubuntu {
    font-family: 'Ubuntu', sans-serif;
}

.Source-Sans-3 {
    font-family: 'Source Sans 3', sans-serif;
}

.Nato-Sans {
    font-family: 'Noto Sans', sans-serif;
}

.Merry-Whethers {
    font-family: 'Merriweather', serif;
}

.Pt-Sans {
    font-family: 'PT Sans', sans-serif;
}

.Macondo {
    font-family: 'Macondo', cursive;
}

.Plus-Jakarta-Sans {
    font-family: 'Plus Jakarta Sans', sans-serif;
}

.Inter {
    font-family: 'Inter', sans-serif;
}


.CatCard {
    transition: 0.25s ease-in-out;
}

.CatCard:hover {
    text-shadow: 1px 0px 1px cyan;
    box-shadow: 5px 10px 28px;
}

.section2Cardp {
    max-width: 77.5%;
}


.BlogCard {
    color: cadetblue;
    transition: 0.25s ease-in-out;
}

.BlogCard:hover {
    text-shadow: 1px 1px 1px cyan;
    box-shadow: 0px 0px 5px 5px darkcyan;
    color: blue;
}

.section3Cardp {
    max-width: 85%;
}


.BlogPost {
    padding: 30px 10px;
    font-size: 1.375rem;
    font-family: 'PT Sans', sans-serif;
    background-color: #f6f2fe;
    border-radius: 10px;
    margin-top: 20px;
}

.BlogPost p {
    font-size: 1.25rem;
    margin: 15px 5px;
}

.BlogPost .Date {
    color: grey;
}

.BlogPost .Date span {
    color: blue;
}


.LiTransition {
    transition: 0.25s ease-in-out;
}

.LiTransition-2 {
    transition: 0.5s ease-in-out;
}

.dark_mode_on_cards{
	background-color: transparent;
}

.dark_mode_on_cards a {
    background-image: repeating-linear-gradient(
        45deg,
        #000000,
        transparent 1000px
    );

    color: bisque;
}


.bg-aliceblue {
    background-color: aliceblue;
}

#form{
	transition: all 0.3s ease-in-out; 
}


@media screen and (max-width: 796px) {

    .catcardmedia,
    .blogcardmedia {
        grid-template-columns: repeat(1, 1fr);
        justify-items: center;
    }

    .catcardmedia > div,
    .blogcardmedia > div {
        margin-top: 5vh;
        box-shadow: 0px 0px 0.5px black;
        margin-right: 0;
    }

    .sectionHeader {
        width: 50%;
        margin: auto;
    }
}



</style>
<body class="flex items-center bg-slate-300 flex-col p-2 transition-all baloo-bhai-2-<uniquifier>">

	<%- include('partials/navbar') %>

	<div class="h-100 sm:h-125 lg:h-150 w-full p-3 flex flex-col justify-start items-center text-white bg-cover bg-no-repeat bg-center rounded-2xl" 
	     style="background-image: url('./images/image_bg_2.jpg'); background-repeat: no-repeat; background-position: center; background-size: cover; transition: background-image 1s ease-in-out;" id="bg_image">
	     <a href="#form" class="bg-[#728156] border-3 border-[#235347] text-center text-white transition-all font-semibold cursor-pointer px-5 py-3 mb-20 rounded-4xl hover:bg-[#163832]  transition-all duration-300" id="custom_plan">PLAN ITINERARIES</a>
	</div>


	<section id="section2" class="bg-[aliceblue] p-[70px]">
		<div class="mb-[15px] ml-[15px] sectionHeader">
			<p class="Nato-Sans text-[grey] font-semibold">Get an Idea, click over cards.</p>
			<h1 class="Pt-Sans text-4xl font-bold">Explore</h1>
		</div>
		<div class="grid grid-cols-3 catcardmedia"> 
			<a class="lg:mr-[45px] pb-[35px] bg-white cursor-pointer CatCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('3-hidden-gems-in-japan-most-tourists-completely-miss')">
				<img src="/images/JAPAN.jpg" class="w-full h-[60%]">
				<h1 class="text-center mt-[30px] pb-[10px] Merry-Whethers text-2xl">JAPAN</h1>
				<p class="section2Cardp m-auto Nato-Sans text-[grey]">3 Hidden Gems in Japan Most Tourists Completely Miss</p>
			</a>

			<a class="lg:mr-[45px] pb-[35px] bg-white cursor-pointer CatCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('how-to-pack-for-2-weeks-in-europe-in-just-a-carry-on')">
				<img src="/images/EUROPE.jpg" class="w-full h-[60%]">
				<h1 class="text-center mt-[30px] pb-[10px] Merry-Whethers text-2xl">EUROPE</h1>
				<p class="section2Cardp m-auto Nato-Sans text-[grey]">How to Pack for 2 Weeks in Europe in Just a Carry-On</p>
			</a>

			<a class="lg:mr-[45px] pb-[35px] bg-white cursor-pointer CatCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('is-this-overwater-bungalow-in-bora-bora-actually-worth-the-1200')">
				<img src="/images/BORA BORA.jpg" class="w-full h-[60%]">
				<h1 class="text-center mt-[30px] pb-[10px] Merry-Whethers text-2xl">BORA BORA</h1>
				<p class="section2Cardp m-auto Nato-Sans text-[grey]">Is This Overwater Bungalow in Bora Bora Actually Worth the $1,200?</p>
			</a>
		</div>
	</section>


	<section id="section3" class="py-[70px] px-[30px]">
		<div class="mb-[15px] ml-[60px] sectionHeader">
			<p class="Nato-Sans text-[grey] font-semibold">VISIT SOME BLOGS</p>
			<h1 class="Pt-Sans text-4xl font-bold">Our Blogs</h1>
		</div>
		<div class="grid grid-cols-4 blogcardmedia">

			<a class="mr-[15px] cursor-pointer BlogCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('The-Ultimate-3-Day-Weekend-Guide-to-Tokyo-What-to-Eat-See-and-Do')">
				<img src="/images/JAPAN.jpg" class="w-full h-[60%]">
				<h2 class="mt-[15px] ml-[15px] pb-[10px] Macondo font-bold text-4xl">Tokyo</h2>
				<p class="section3Cardp ml-[15px] Nato-Sans mb-[15px] text-[grey]">The Ultimate 3-Day Weekend Guide to Tokyo: What to Eat, See, and Do</p>
			</a>

			<a class="mr-[15px] cursor-pointer BlogCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('A-4-Day-Road-Trip-Through-the-Swiss-Alps-The-Scenic-Route')">
				<img src="/images/swiss_alps.jpg" class="w-full h-[60%]">
				<h2 class="mt-[15px] ml-[15px] pb-[10px] Macondo font-bold text-4xl">Swiss Alps</h2>
				<p class="section3Cardp ml-[15px] Nato-Sans mb-[15px] text-[grey]">A 4-Day Road Trip Through the Swiss Alps: The Scenic Route</p>
			</a>

			<a class="mr-[15px] cursor-pointer BlogCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('The-Perfect-5-Day-Bali-for-First-Time-Explorers')">
				<img src="/images/bali.jpg" class="w-full h-[60%]">
				<h2 class="mt-[15px] ml-[15px] pb-[10px] Macondo font-bold text-4xl">Bali</h2>
				<p class="section3Cardp ml-[15px] Nato-Sans mb-[15px] text-[grey]">The Perfect 5-Day Bali for First-Time Explorers</p>
			</a>

			<a class="mr-[15px] cursor-pointer BlogCard LiTransition max-w-[125vw] mt-10" onclick="openBlog('How-to-Spend-7-Magic-Days-in-Paris-on-a-Strict-Budget')">
				<img src="/images/paris.jpg" class="w-full h-[60%]">
				<h2 class="mt-[15px] ml-[15px] pb-[10px] Macondo font-bold text-4xl">Paris</h2>
				<p class="section3Cardp ml-[15px] Nato-Sans mb-[15px] text-[grey]">How to Spend 7 Magic Days in Paris on a Strict Budget</p>
			</a>

		</div>
	</section>





	<div class="border-7 border-[#bfc7ab] w-full max-w-200 rounded-4xl mt-10 p-5 sm:p-10 md:p-15 flex flex-col items-center transition-[transform] font-semibold text-2xl" style="background-image: repeating-linear-gradient(45deg, #82abae, transparent 200px);" id="form">
		
		<input id="location" class="border-7 border-[#747864] rounded-xl p-4 my-4 w-full focus:bg-black focus:text-green-200" placeholder="From which country ?">

		<div class="relative w-full">

		    <input
		        id="destination"
		        class="border-7 border-[#747864] rounded-xl p-4 w-full"
		        placeholder="where you wanna go?"
		        autocomplete="off"
		    >

		    <div
		        id="suggestions"
		        class="absolute left-2 right-2 top-full bg-white text-black rounded-xl shadow-xl z-50 hidden"
		    ></div>

		</div>
		
		<select id="persona" class="bg-[#3c4f3c] pt-3 pb-3 pr-6 pl-6 rounded-2xl m-3 text-white cursor-cursor-pointer transition-all hover:bg-black hover:text-[lime] hover:border-[lime]">
			<option>Backpacker</option>
			<option>Luxury</option>
			<option>Family</option>
		</select>

		<select id="duration" class="py-3 px-10 cursor-cursor-pointer bg-[#3c4f3c] text-white p-2 rounded-xl hover:bg-black hover:text-[lime] hover:border-3 transition-all">
		    <option value="1">1 Day</option>
		    <option value="2">2 Days</option>
		    <option value="3">3 Days</option>
		    <option value="4">4 Days</option>
		    <option value="5">5 Days</option>
		    <option value="7">7 Days</option>
		</select>

		<button class="pt-2 pb-2 px-14 m-3 cursor-cursor-pointer bg-gray-500
		text-white rounded-2xl transition-all hover:bg-black hover:text-[lime]" id="submit_btn">
			
			<span id="submit_text">Submit</span>

		</button>
    	<span id="loader" class="fixed inset-5 hidden transition-all flex flex-cols items-center justify-center bg-lime-100/60 backdrop-blur rounded-2xl z-[9999]"
    		style="background-image: url('/images/loading.gif'); background-repeat: no-repeat; background-size: 170px; background-position: center;">
    		LOADING...
    	</span>

    	<%- include('partials/loader') %>
		
	</div>

	<div id="Headers" class="flex flex-col items-center justify-center p-5 rounded-2xl m-5 text-2xl font-semibold"></div>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3  gap-4 w-full h-auto bg-gray-500 text-white rounded-xl text-2xl font-semibold italic" id="results"></div>

	<%- include('partials/footer') %>

</body>
<script src="/script.js"></script>
</html>
