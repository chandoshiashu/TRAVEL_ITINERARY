<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Roamio | <%= Blog.Blog_Title %></title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400..800&family=Comic+Relief:wght@400;700&display=swap" rel="stylesheet">


</head>

<body class="bg-slate-300 min-h-screen p-5 baloo-bhai-2-<uniquifier>">

    <%- include('partials/navbar') %>

    <h1 class="text-5xl font-bold text-center m-10">
        <%= Blog.Blog_Title %>
    </h1>


    <% Blog.Subtopics.forEach(function(subtopic, index) { %>
        <div class="mb-8 p-4 bg-white rounded-lg shadow flex flex-col items-center justify-center" style="font-family: revert;">
            <h2 class="text-2xl font-semibold mb-2"><%= subtopic %></h2>
            
            <% Blog.Contents[index].forEach(function(para) { %>
                <p class="text-gray-700 mb-4"><%= para ? para : 'No Content Available. ' %></p> 
            <% }); %>

            <% if(ImageResponseArray && ImageResponseArray[index] && ImageResponseArray[index] !== '/images/default.jpg') { %>
                <img src='<%= ImageResponseArray[index] %>' alt="<%= subtopic %>" class="w-full max-w-2xl rounded">
            <% } %>
        </div>
    <% }); %>

    <%- include('partials/footer') %>


</body>
<script src="/script.js"></script>
</html>
