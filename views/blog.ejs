<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Roamio | <%= Blog.Blog_Title %></title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400..800&family=Comic+Relief:wght@400;700&display=swap" rel="stylesheet">


</head>

<body class="bg-slate-300 min-h-screen p-5 baloo-bhai-2-<uniquifier>">

    <h1 class="text-5xl font-bold text-center m-10">
        <%= Blog.Blog_Title %>
    </h1>


    <% Blog.Subtopics.forEach(function(subtopic, index) { %>
        <div>
            <h2><%= subtopic %></h2>
            <p><%= Blog.Contents[index] ? Blog.Contents[index] : 'No Content Available. ' %></p>
        </div>
        <img src=' <%= ImageResponseArray[index] %> '>
    <% }); %>


</body>
</html>
