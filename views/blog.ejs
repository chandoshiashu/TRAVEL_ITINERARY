<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Roamio | <%= Blog.Blog_Title %></title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400..800&family=Comic+Relief:wght@400;700&display=swap" rel="stylesheet">


</head>

<body class="flex items-center bg-slate-300 flex-col p-2 transition-all baloo-bhai-2-<uniquifier>">

    <%- include('partials/navbar') %>

    <h1 class="text-5xl font-bold text-center m-10" id="blog_header">
        <%= Blog.Blog_Title %>
    </h1>


    <% Blog.Subtopics.forEach(function(subtopic, index) { %>
        <div class="mb-8 mx-auto w-[80%] text-2xl p-10 bg-white rounded-lg shadow flex flex-col items-center justify-center" style="background-image: repeating-linear-gradient(45deg, #c6dee7, transparent 800px); font-family: revert;">
            <h2 class="text-2xl font-bold mb-11 text-center"><%= subtopic %></h2>
            
            <% Blog.Contents[index].forEach(function(para) { %>
                <p class="text-gray-700 mb-10 font-semibold"><%= para ? para : 'No Content Available. ' %></p> 
            <% }); %>

        </div>
    <% }); %>

    <%- include('partials/loader') %>
    <%- include('partials/footer') %>


</body>
<script src="/script.js"></script>
</html>
